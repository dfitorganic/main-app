# Django
DEBUG=True
SECRET_KEY=replace-with-a-strong-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (optional for local; sqlite is used if DATABASE_URL is empty)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Payments: leave blank until Razorpay is configured and verified server-side
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
